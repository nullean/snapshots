  static class PublicApiAssertions
    static AndConstraint<AssemblyAssertions> MatchApiSnapshot(this AssemblyAssertions assertions, ApiSplit split = ApiSplit.None, ApiComparisonOptions? comparison = null, string? name = null, SnapshotOptions? options = null, string because = "", [CallerFilePath] string callerFilePath = "", [CallerMemberName] string callerMemberName = "", [CallerLineNumber] int callerLineNumber = 0)

