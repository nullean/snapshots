assembly Nullean.Snapshots.TUnit
using Nullean.Snapshots: SnapshotTestIdentity
using interface Nullean.Snapshots: ISnapshotTestIdentityProvider
using System: AttributeUsageAttribute, Func<>
using System.Collections.Generic: IEnumerable<>
using System.ComponentModel: EditorBrowsableAttribute
using TUnit.Core: DataGeneratorMetadata, UntypedDataSourceGeneratorAttribute

namespace Nullean.Snapshots.TUnit
  [AttributeUsage((AttributeTargets)2112, AllowMultiple = false)]
  sealed class HttpFilesAttribute : SnapshotFilesAttribute
    HttpFilesAttribute(string folder = "http")

  [AttributeUsage((AttributeTargets)2112, AllowMultiple = false)]
  sealed class JourneyFilesAttribute : SnapshotFilesAttribute
    JourneyFilesAttribute(string folder = "journeys")

  [AttributeUsage((AttributeTargets)2112, AllowMultiple = false)]
  class SnapshotFilesAttribute : UntypedDataSourceGeneratorAttribute
    SnapshotFilesAttribute(string folder, string pattern)
    string Folder { get; }
    string Pattern { get; }
    protected override IEnumerable<Func<object?[]?>> GenerateDataSources(DataGeneratorMetadata dataGeneratorMetadata)

  [EditorBrowsable((EditorBrowsableState)1)]
  static class TUnitRegistration
    static void Initialize()

  sealed class TUnitTestIdentity : ISnapshotTestIdentityProvider
    SnapshotTestIdentity? Current { get; }
    static TUnitTestIdentity Instance { get; }
    static void Register()
