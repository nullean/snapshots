assembly Nullean.Snapshots.Yaml
using AwesomeAssertions: AndConstraint<>
using AwesomeAssertions.Primitives: StringAssertions
using Nullean.Snapshots: SnapshotComparison, SnapshotOptions
using Nullean.Snapshots.Trees: Node, TreeDiffOptions, TreeSnapshotFormat
using System.Diagnostics.CodeAnalysis: StringSyntaxAttribute
using System.Runtime.CompilerServices: CallerArgumentExpressionAttribute, CallerFilePathAttribute, CallerLineNumberAttribute, CallerMemberNameAttribute

namespace Nullean.Snapshots.Yaml
  static class YamlAssertions
    static AndConstraint<StringAssertions> BeYaml(this StringAssertions assertions, [StringSyntax("yaml")] string expected, TreeDiffOptions? diff = null, string because = "")
    static AndConstraint<StringAssertions> MatchInlineYamlSnapshot(this StringAssertions assertions, [StringSyntax("yaml")] string? expected = null, TreeDiffOptions? diff = null, SnapshotOptions? options = null, string because = "", [CallerArgumentExpression("expected")] string? expectedExpression = null, [CallerFilePath] string callerFilePath = "", [CallerMemberName] string callerMemberName = "", [CallerLineNumber] int callerLineNumber = 0)
    static AndConstraint<StringAssertions> MatchYamlSnapshot(this StringAssertions assertions, TreeDiffOptions? diff = null, string? name = null, SnapshotOptions? options = null, string because = "", [CallerFilePath] string callerFilePath = "", [CallerMemberName] string callerMemberName = "", [CallerLineNumber] int callerLineNumber = 0)

  static class YamlSnapshot
    static TreeSnapshotFormat Format { get; }
    static SnapshotComparison Compare(string expected, string actual, TreeDiffOptions? options = null)
    static TreeSnapshotFormat FormatWith(TreeDiffOptions? options)
    static Node Parse(string yaml)
