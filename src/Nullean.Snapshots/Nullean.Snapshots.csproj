<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Nullean.Snapshots</RootNamespace>
    <Description>Lightweight snapshot testing: the store, accept modes, scrubbers, the line differ and the failure message.</Description>
    <PackageTags>snapshot;approval;testing;golden;diff</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="System.IO.Abstractions" />
    <PackageReference Include="Nullean.ScopedFileSystem" />
  </ItemGroup>

  <!-- buildTransitive, so every package that depends on this one brings the folders and assembly metadata along. -->
  <ItemGroup>
    <None Include="buildTransitive/Nullean.Snapshots.targets" Pack="true" PackagePath="buildTransitive/Nullean.Snapshots.targets" />
    <None Include="buildTransitive/Nullean.Snapshots.targets" Pack="true" PackagePath="build/Nullean.Snapshots.targets" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nullean.Snapshots.Json" />
    <!-- JsonTree, for JSON response bodies: the HTTP format must not need AwesomeAssertions or .Json. -->
    <InternalsVisibleTo Include="Nullean.Snapshots.Http" />
    <InternalsVisibleTo Include="Nullean.Snapshots.Tests" />
    <InternalsVisibleTo Include="Nullean.Snapshots.Browser.Tests" />
    <InternalsVisibleTo Include="Nullean.Snapshots.Html.Tests" />
    <InternalsVisibleTo Include="Nullean.Snapshots.Images.Tests" />
    <InternalsVisibleTo Include="Nullean.Snapshots.Json.Tests" />
    <InternalsVisibleTo Include="Nullean.Snapshots.Yaml.Tests" />
    <InternalsVisibleTo Include="Nullean.Snapshots.Http.Tests" />
    <!-- The CLI ships self-contained with its own copy of this assembly, so the internals cannot drift apart. -->
    <InternalsVisibleTo Include="snap" />
    <InternalsVisibleTo Include="Nullean.Snapshots.Cli.Tests" />
  </ItemGroup>

</Project>
