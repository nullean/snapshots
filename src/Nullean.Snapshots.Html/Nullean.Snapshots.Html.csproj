<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Nullean.Snapshots.Html</RootNamespace>
    <Description>HTML snapshots and inline HTML assertions for Nullean.Snapshots: pretty-printed with AngleSharp, compared structurally with AngleSharp.Diffing.</Description>
    <PackageTags>snapshot;approval;testing;html;anglesharp;awesomeassertions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="AngleSharp.Diffing" />
    <ProjectReference Include="../Nullean.Snapshots/Nullean.Snapshots.csproj" />
    <ProjectReference Include="../Nullean.Snapshots.AwesomeAssertions/Nullean.Snapshots.AwesomeAssertions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nullean.Snapshots.Html.Tests" />
  </ItemGroup>

</Project>
